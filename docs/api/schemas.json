        },
        "text": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "cpc": {
          "type": "number",
          "minimum": 0
        },
        "yoy": {
          "type": "number"
        },
        "difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "spark": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "Site": {
      "type": "object",
      "required": [
        "domain",
        "kind",
        "label",
        "synthetic",
        "verified",
        "holder",
        "scope",
        "source",
        "note",
        "verifiedOn",
        "crawlers",
        "audit"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "dmo",
            "editorial",
            "ota",
            "hotel"
          ]
        },
        "label": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifiedOn": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "crawlers": {
          "$ref": "#/components/schemas/CrawlerMap"
        },
        "audit": {
          "$ref": "#/components/schemas/Audit"
        }
      }
    },
    "Hotel": {
      "type": "object",
