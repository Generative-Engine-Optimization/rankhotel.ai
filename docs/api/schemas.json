          "type": "number",
          "minimum": 0
        },
        "yoy": {
          "type": "number"
        },
        "difficulty": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "fanout": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "share"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "month",
              "volume",
              "cpc"
            ],
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "volume": {
                "type": "number",
                "minimum": 0
              },
              "cpc": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "SummaryCell": {
      "type": "object",
      "required": [
        "byEngine",
        "mentionRate",
        "prompts"
      ],
      "properties": {
        "byEngine": {
          "type": "object",
          "required": [
            "chatgpt",
            "gemini",
            "perplexity"
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "mentionRate",
              "position"
            ],
            "properties": {
              "mentionRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "position": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "mentionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "prompts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Tag": {
      "type": "object",
      "required": [
        "key",
        "slug",
        "icon",
        "name",
        "lead",
        "count"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "slug": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "icon": {
          "type": "string"
        },
        "name": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "lead": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ResponseMeta": {
      "type": "object",
      "required": [
        "generatedFor",
        "version"
      ],
      "properties": {
        "generatedFor": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "version": {
          "type": "string"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1
        },
        "simulated": {
          "type": "boolean"
        }
      }
    },
    "ApiError": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "status",
            "code",
            "message"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 400,
              "maximum": 599
            },
            "code": {
              "type": "string",
              "enum": [
                "not_found",
                "bad_request",
                "unauthorized",
                "rate_limited",
                "server_error"
              ]
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
