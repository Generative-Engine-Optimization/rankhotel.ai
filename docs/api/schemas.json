        "category": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "area": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "domain": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "verified",
            "registry-web",
            "registry",
            "chain",
            "guarded",
            "listed",
            "generated"
          ]
        },
        "score": {
          "$ref": "#/components/schemas/Stat"
        },
        "byEngine": {
          "type": "object",
          "required": [
            "chatgpt",
            "gemini",
            "perplexity"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "presence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "avgPosition": {
          "type": "number",
          "minimum": 0
        },
        "auditScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "trend": {
          "type": "number"
        },
        "destinationRank": {
          "type": "integer",
          "minimum": 1
        }
      }
