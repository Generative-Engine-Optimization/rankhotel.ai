        "short": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "icon": {
          "type": "string"
        },
        "lead": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "comparativeSubject": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "byEngine": {
          "type": "object",
          "required": [
            "chatgpt",
            "gemini",
            "perplexity"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "factors": {
          "type": "object",
          "required": [
            "comparative",
            "internal",
            "sources",
            "technical"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "visitors": {
          "type": "number",
          "minimum": 0
        },
        "hotelsTracked": {
          "type": "integer",
          "minimum": 0
        },
        "ranking": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "HotelSummary": {
      "type": "object",
      "required": [
        "key",
        "name",
        "destination",
        "destinationName",
        "category",
        "area",
        "stars",
        "domain",
        "synthetic",
        "confidence",
        "score",
        "byEngine",
        "presence",
        "avgPosition",
        "auditScore",
        "trend",
        "destinationRank"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "destination": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "destinationName": {
          "$ref": "#/components/schemas/LocalizedText"
