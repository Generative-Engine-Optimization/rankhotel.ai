---
import EngineLogo from "./EngineLogo.astro";
import type { Locale } from "../lib/config";
import { messages } from "../lib/i18n";
import { ENGINES, engineMeta } from "../lib/observatory";

const { locale, entities } = Astro.props as {
  locale: Locale;
  entities: { name: string; byEngine: Record<string, number> }[];
};

const t = messages(locale).observatory;

// Quante volte un assistente nomina un'entità. Le soglie non sono quelle del
// punteggio: qui si misura un tasso di menzione, e due terzi delle risposte è
// un'altra cosa da un 65 su 100. Restano quelle di prima, scritte una volta.
const coverageBand = (value: number): "high" | "mid" | "low" =>
  value >= 0.66 ? "high" : value >= 0.35 ? "mid" : "low";
---

<div class="table-wrap table-dense">
  <table>
    <thead>
      <tr>
        <th scope="col">{t.entities.entity}</th>
        {
          ENGINES.map((engine) => (
            <th scope="col" class="text-right">
              <EngineLogo engine={engine} size={15} showName={false} class="justify-end" />
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        entities.map((entity) => (
          <tr>
            <td class="font-bold">{entity.name}</td>
            {ENGINES.map((engine) => {
              const value = entity.byEngine[engine];
              // Una soglia sola per la cifra e per la barra: erano due
              // espressioni gemelle, e il colore della barra era scritto a mano
              // in uno style invece di venire dalle classi del foglio.
              const band = coverageBand(value);
              const tone = {
                high: "text-success-ink",
                mid: "text-gold-ink",
                low: "text-danger-ink",
              }[band];
              return (
                <td class="text-right">
                  <span class="inline-flex items-center gap-2">
                    <span class={`bar w-16 bar-${band}`}>
                      <span style={`width:${Math.max(2, value * 100)}%`} />
                    </span>
                    <span class={`num text-[0.85rem] ${tone}`}>{Math.round(value * 100)}%</span>
                  </span>
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
