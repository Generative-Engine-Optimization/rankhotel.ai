---
import EngineLogo from "./EngineLogo.astro";
import Icon from "./Icon.astro";
import type { Locale } from "../lib/config";
import { messages } from "../lib/i18n";
import { ENGINES, engineMeta, inScopeFunnel, type PromptRow } from "../lib/observatory";
import Flag from "./Flag.astro";
import FunnelTag from "./FunnelTag.astro";
import LangTag from "./LangTag.astro";

const { locale, prompts, id } = Astro.props as {
  locale: Locale;
  prompts: PromptRow[];
  id?: string;
};

const t = messages(locale).observatory;
const stages = inScopeFunnel();
---

<div class="grid gap-3.5" data-prompts id={id}>
  <div class="flex flex-wrap items-center gap-2">
    <button class="chip" type="button" data-filter="funnel" data-value="" data-active="true">
      {t.filters.all}
    </button>
    {
      stages.map((stage) => (
        <button
          class="chip chip-funnel gap-1.5"
          type="button"
          data-funnel={stage.key}
          data-filter="funnel"
          data-value={stage.key}
        >
          <Icon name={stage.icon} size={15} />
          {stage.name[locale]}
        </button>
      ))
    }
    <span class="mx-1 h-5 w-px bg-line" aria-hidden="true"></span>
    <button class="chip" type="button" data-filter="lang" data-value="" data-active="true">
      {t.filters["both-langs"]}
    </button>
    <button class="chip gap-1.5" type="button" data-filter="lang" data-value="it">
      <Flag locale="it" size={15} />
      IT
    </button>
    <button class="chip gap-1.5" type="button" data-filter="lang" data-value="en">
      <Flag locale="en" size={15} />
      EN
    </button>
  </div>

  <div class="grid gap-2.5 lg:grid-cols-2">
    {
      prompts.map((prompt) => (
        <article
          class="card grid gap-2.5"
          data-prompt
          data-funnel={prompt.funnel}
          data-lang={prompt.lang}
        >
          <div class="flex items-start justify-between gap-3">
            <p class="font-mono text-[0.9rem]">«{prompt.text}»</p>
            <span class="pill shrink-0"><LangTag locale={locale} lang={prompt.lang} /></span>
          </div>
          <FunnelTag
            locale={locale}
            funnel={prompt.funnel}
            size={14}
            class="text-[0.8rem] font-bold"
          />
          <div class="grid gap-1.5">
            {ENGINES.map((engine) => {
              const row = prompt.byEngine[engine];
              return (
                <div class="grid grid-cols-[auto_1fr_auto] items-center gap-2.5">
                  <EngineLogo engine={engine} size={16} showName={false} class="text-muted" />
                  <span class="bar">
                    <span style={`width:${Math.max(2, row.mentionRate * 100)}%`} />
                  </span>
                  <span class="num text-[0.8rem] text-muted">
                    {Math.round(row.mentionRate * 100)}% · {t.table["position-short"]}{" "}
                    {row.position}
                  </span>
                </div>
              );
            })}
          </div>
        </article>
      ))
    }
  </div>
  <p class="text-[0.85rem] text-muted" data-prompt-count data-template={t.prompts.count}></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-prompts]").forEach((root) => {
    const state: Record<string, string> = { funnel: "", lang: "" };
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-prompt]"));
    const counter = root.querySelector<HTMLElement>("[data-prompt-count]");
    const template = counter?.dataset.template ?? "";

    function apply() {
      let visible = 0;
      for (const card of cards) {
        const ok =
          (!state.funnel || card.dataset.funnel === state.funnel) &&
          (!state.lang || card.dataset.lang === state.lang);
        card.hidden = !ok;
        if (ok) visible += 1;
      }
      if (counter) counter.textContent = template.replace("{n}", String(visible));
    }

    root.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.dataset.filter!;
        state[group] = button.dataset.value ?? "";
        root
          .querySelectorAll(`[data-filter="${group}"]`)
          .forEach((b) => b.setAttribute("data-active", String(b === button)));
        apply();
      });
    });

    apply();
  });
</script>
