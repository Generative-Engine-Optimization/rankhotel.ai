---
import type { Locale } from "../lib/config";
import { number, percent } from "../lib/format";
import type { CitationSource } from "../lib/observatory";

const { locale, labels, sources } = Astro.props as {
  locale: Locale;
  labels: any;
  sources: CitationSource[];
};
---

<div class="card">
  <h3 class="mb-4">{labels.citations["top-sources"]}</h3>
  <div class="grid">
    {
      sources.map((source) => (
        <div class="flex justify-between gap-5 border-t border-line py-[13px] first:border-t-0 first:pt-0">
          <div>
            <strong>{source.domain}</strong>
            <br />
            <small class="text-muted">
              {labels.citations.kind[source.kind]}
            </small>
          </div>
          <div class="grid justify-items-end font-mono font-bold text-accent-ink">
            <span>{percent(locale, source.share)}</span>
            <small class="font-medium text-muted">
              {number(locale, source.occurrences)}
            </small>
          </div>
        </div>
      ))
    }
  </div>
</div>
