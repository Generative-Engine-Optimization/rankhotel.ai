---
import type { Locale } from "../lib/config";
import InfoTip from "./InfoTip.astro";
import ShareButton from "./ShareButton.astro";

// Il blocco che compone ogni pagina: intestazione, spiegazione facoltativa,
// link condivisibile alla sezione. Prima questa struttura era copiata a mano in
// ogni template, con quattro varianti leggermente diverse fra loro.
const {
  locale,
  id,
  title,
  lead,
  eyebrow,
  info,
  share = true,
  bare = false,
  wide = false,
} = Astro.props as {
  locale: Locale;
  id: string;
  title?: string;
  lead?: string;
  eyebrow?: string;
  info?: string;
  share?: boolean;
  bare?: boolean;
  wide?: boolean;
};
---

<section class={bare ? "" : "section"} id={id} data-section={id}>
  <div class={`shell grid gap-[34px] ${wide ? "" : ""}`}>
    {
      title && (
        <header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <div class="grid max-w-[820px] gap-3.5">
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h2 class="flex flex-wrap items-center gap-2">
              <span>{title}</span>
              {info && <InfoTip locale={locale} text={info} />}
            </h2>
            {lead && <p class="lead">{lead}</p>}
          </div>
          {share && <ShareButton locale={locale} target={id} />}
        </header>
      )
    }
    <slot />
  </div>
</section>
