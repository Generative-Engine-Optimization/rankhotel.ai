---
import type { Locale } from "../lib/config";
import { messages } from "../lib/i18n";

const { locale } = Astro.props as { locale: Locale };
const wip = messages(locale).observatory.wip;
---

<aside
  class="shell mt-6 grid gap-[18px] rounded-(--radius-brand) border border-gold/40 bg-gold/10 px-4 py-3.5 md:grid-cols-[160px_1fr]"
  aria-label={wip.title}
>
  <strong class="text-gold-ink">{wip.title}</strong>
  <span class="text-muted">{wip.body}</span>
</aside>
