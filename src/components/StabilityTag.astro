---
import type { Locale } from "../lib/config";
import { messages } from "../lib/i18n";
import type { Stat } from "../lib/observatory";
import InfoTip from "./InfoTip.astro";

const { locale, stat } = Astro.props as { locale: Locale; stat: Stat };
const t = messages(locale).observatory;
// Un numero solo non dice se ci si può contare sopra: questo sì.
const tone = {
  stable: "text-success-ink",
  moderate: "text-gold-ink",
  volatile: "text-danger-ink",
}[stat.stability];
---

<span class="inline-flex items-center gap-1.5">
  <span class={`pill ${tone}`}>{t.score.stability[stat.stability]}</span>
  <InfoTip locale={locale} text={t.score["stability-help"]} />
</span>
