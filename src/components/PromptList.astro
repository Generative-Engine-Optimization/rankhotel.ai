---
const { prompts, placeholder } = Astro.props as {
  prompts: { intent: string; template: string }[];
  placeholder: string;
};
---

<div class="table-wrap">
  <table>
    <tbody>
      {
        prompts.map((prompt) => (
          <tr>
            <td class="font-mono text-muted">{prompt.intent}</td>
            <td>{prompt.template.replace("{city}", placeholder)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
