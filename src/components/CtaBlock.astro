---
import { LINKS, type Locale } from "../lib/config";
import Icon from "./Icon.astro";

const {
  title,
  body,
  primary,
  secondary = [],
} = Astro.props as {
  title: string;
  body: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string }[];
};
---

<div
  class="grid justify-items-center gap-[22px] rounded-(--radius-brand) border border-line-strong bg-surface-muted px-6 py-[42px] text-center"
>
  <h2 class="max-w-[620px]">{title}</h2>
  <p class="lead max-w-[640px]">{body}</p>
  <div class="flex flex-wrap justify-center gap-2.5">
    <a class="btn gap-2" href={primary.href}>
      {primary.label}
      <Icon name="arrowRight" size={17} />
    </a>
    {secondary.map((item) => <a class="btn btn-secondary" href={item.href}>{item.label}</a>)}
  </div>
</div>
