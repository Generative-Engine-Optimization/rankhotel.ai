---
import type { Locale } from "../lib/config";
import { decimal } from "../lib/format";
import { messages } from "../lib/i18n";
import { scoreColor, scoreColorSoft, type Stat } from "../lib/observatory";

// Il punteggio è il numero che regge tutto il sito: merita di essere letto
// prima del testo che lo circonda.
//
// Tre scelte, tutte funzionali:
// 1. Colore continuo invece di tre fasce secche. Un 64 e un 66 non devono
//    cambiare colore di colpo solo perché cade una soglia arbitraria.
// 2. Anello di progressione: dice quanto manca a cento senza aggiungere parole.
//    La sua parte chiara è la banda di oscillazione, disegnata sull'anello.
// 3. Cifre a larghezza fissa. Senza, in una colonna di punteggi il "1" fa
//    ballare l'incolonnamento e la tabella diventa illeggibile.
const {
  locale,
  stat,
  size = "md",
  showBand = true,
  ring = true,
  label,
} = Astro.props as {
  locale: Locale;
  stat: Stat;
  size?: "sm" | "md" | "lg";
  showBand?: boolean;
  ring?: boolean;
  label?: string;
};

const t = messages(locale).observatory;
const value = Math.max(0, Math.min(100, stat.mean));

const tone = scoreColor(value);
const soft = scoreColorSoft(value);

const sizes = {
  sm: { box: 34, font: "1rem", stroke: 3, band: "0.66rem" },
  md: { box: 58, font: "1.6rem", stroke: 4.5, band: "0.72rem" },
  lg: { box: 92, font: "2.6rem", stroke: 6, band: "0.8rem" },
}[size];

// Solo i quadranti grandi si disegnano. La taglia `sm` vive dentro le tabelle
// e le schede: cento anelli che partono insieme non sono un effetto, sono una
// pagina che si muove mentre la si legge.
const draws = size !== "sm";

const R = 45;
const CIRC = 2 * Math.PI * R;
const dash = (value / 100) * CIRC;
// La banda si disegna sull'anello: dove il punteggio potrebbe essere finito.
const bandStart = Math.max(0, value - stat.stdDev) / 100;
const bandLength = Math.min(1, (2 * stat.stdDev) / 100);

const title = `${t.score.runs.replace("{n}", String(stat.runs))} · ${stat.min}–${stat.max}`;
---

<span class="inline-flex items-center gap-2 align-middle" title={title}>
  {
    ring ? (
      <span class="relative inline-grid place-items-center" style={`width:${sizes.box}px;height:${sizes.box}px`}>
        <svg viewBox="0 0 100 100" class="absolute inset-0 -rotate-90" aria-hidden="true">
          <circle cx="50" cy="50" r={R} fill="none" stroke="var(--color-surface-raised)" stroke-width={sizes.stroke} />
          {showBand && stat.stdDev > 0 && (
            <circle
              class={draws ? "dial-band-arc" : undefined}
              cx="50"
              cy="50"
              r={R}
              fill="none"
              stroke={soft}
              stroke-width={sizes.stroke + 3}
              stroke-linecap="butt"
              stroke-dasharray={`${(bandLength * CIRC).toFixed(1)} ${CIRC}`}
              stroke-dashoffset={`${(-bandStart * CIRC).toFixed(1)}`}
            />
          )}
          {/* La lunghezza del tratto viaggia come variabile perché è da lì che
              l'anello parte: coperto per tutta la sua misura, e scoperto fino
              a zero. Il valore finale resta quello dell'attributo, quindi un
              browser che non anima disegna comunque l'anello giusto. */}
          <circle
            class={draws ? "dial-ring" : undefined}
            style={draws ? `--dial-dash:${dash.toFixed(1)}` : undefined}
            cx="50"
            cy="50"
            r={R}
            fill="none"
            stroke={tone}
            stroke-width={sizes.stroke}
            stroke-linecap="round"
            stroke-dasharray={`${dash.toFixed(1)} ${CIRC}`}
          />
        </svg>
        <span
          class="font-display font-bold tabular-nums"
          style={`font-size:${sizes.font};color:${tone};letter-spacing:-0.04em;line-height:1`}
        >
          {decimal(locale, stat.mean, 0)}
        </span>
      </span>
    ) : (
      <span
        class="font-display font-bold tabular-nums"
        style={`font-size:${sizes.font};color:${tone};letter-spacing:-0.04em;line-height:1`}
      >
        {decimal(locale, stat.mean, 0)}
      </span>
    )
  }
  {
    (showBand || label) && (
      <span class="grid gap-0.5 self-center leading-tight">
        {showBand && (
          <span class="num text-faint" style={`font-size:${sizes.band}`}>
            ±{decimal(locale, stat.stdDev, stat.stdDev < 1 ? 1 : 0)}
          </span>
        )}
        {label && <span class="text-[0.78rem] text-muted">{label}</span>}
      </span>
    )
  }
</span>
