---
import RegionMark from "./RegionMark.astro";
import Icon from "./Icon.astro";
import Panel from "./Panel.astro";
import Skeleton from "./Skeleton.astro";
import { comparePath, destinationPath, type Locale } from "../lib/config";
import { decimal } from "../lib/format";
import { interpolate, messages } from "../lib/i18n";
import {
  ENGINES,
  FACTOR_KEYS,
  META,
  SCORE_WEIGHTS,
  destinationIcon,
  engineMeta,
  listCategories,
  listDestinations,
} from "../lib/observatory";

// Il confronto è l'unico punto del sito in cui l'utente costruisce la vista da
// sé. Tre cose devono funzionare bene: scegliere fra cento territori senza
// scorrerli tutti, capire a colpo d'occhio quanti posti restano, e leggere una
// riga sapendo subito chi è davanti. Il resto è la stessa grammatica del sito.
const { locale, presets } = Astro.props as {
  locale: Locale;
  presets: { label: string; keys: string[]; names: string[] }[];
};

const t = messages(locale).observatory;
const destinations = listDestinations();
const categories = listCategories();

// Ricerca senza accenti: chi scrive "val d'orcia" o "Val d'Òrcia" deve trovare
// la stessa riga, e "campania" deve bastare per arrivare alla Costiera.
const normalize = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();

const options = categories.map((category) => ({
  category,
  rows: destinations
    .filter((destination) => destination.category === category.key)
    .map((destination) => ({
      destination,
      search: normalize(
        [
          destination.name[locale],
          destination.region,
          category.name[locale],
          ...destination.tags,
        ].join(" "),
      ),
    })),
}));

const clientLabels = {
  locale,
  loading: t.compare.loading,
  errorTitle: t.compare["error-title"],
  errorBody: t.compare["error-body"],
  retry: t.compare.retry,
  remove: t.compare["remove-one"],
  slotAdd: t.compare["slot-add"],
  count: t.compare.count,
  best: t.compare.best,
  verdict: t.compare.verdict,
  verdictTie: t.compare["verdict-tie"],
  verdictClose: t.compare["verdict-close"],
  score: t.score.label,
  runs: t.score.runs,
  open: t.compare.rows.open,
  groups: t.compare.groups,
  rows: t.compare.rows,
  rankPosition: t.rank.position,
  rankRange: t.rank.range,
  rankExact: t.rank.exact,
  stability: t.score.stability,
  tiers: Object.fromEntries(META.tiers.map((tier) => [tier.key, tier.name[locale]])),
  factors: Object.fromEntries(
    FACTOR_KEYS.map((key) => [
      key,
      {
        name: t.factors[key].name,
        weight: interpolate(t.factors.weight, { n: SCORE_WEIGHTS[key] }),
      },
    ]),
  ),
  engines: Object.fromEntries(
    ENGINES.map((key) => [
      key,
      {
        label: engineMeta(key)?.label ?? key,
        logo: `/assets/engines/${key}.svg`,
        rank: t.engines.rank,
      },
    ]),
  ),
  sources: {
    dmo: t.sources.dmo,
    editorial: t.sources.editorial,
    ota: t.sources.ota,
    other: t.sources.other,
  },
  paths: Object.fromEntries(
    destinations.map((d) => [d.key, destinationPath(locale, d.slug[locale])]),
  ),
};
---

<div
  class="grid gap-[26px]"
  data-compare
  data-base={comparePath(locale)}
  data-labels={JSON.stringify(clientLabels)}
>
  <div class="grid gap-3">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3.5">
      <div class="combo grid w-full max-w-[430px] gap-1.5" data-combo>
        <label class="text-[0.82rem] text-muted" for="compare-search">
          {t.compare["search-label"]}
        </label>
        <div class="relative">
          <span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-faint">
            <Icon name="search" size={16} />
          </span>
          <input
            id="compare-search"
            class="min-h-11 w-full rounded-(--radius-brand) border border-line bg-surface pr-3 pl-9 placeholder:text-faint"
            type="text"
            role="combobox"
            aria-expanded="false"
            aria-controls="compare-options"
            aria-autocomplete="list"
            autocomplete="off"
            placeholder={t.compare["search-placeholder"]}
            data-combo-input
          />
        </div>
        <p class="text-[0.78rem] text-faint" data-combo-hint>{t.compare["search-hint"]}</p>
        <ul
          class="combo-list"
          id="compare-options"
          role="listbox"
          aria-label={t.compare["search-label"]}
          data-combo-list
          hidden
        >
          {
            options.map(({ category, rows }) => (
              <>
                <li class="combo-group" role="presentation" data-combo-header={category.key}>
                  {category.name[locale]}
                </li>
                {rows.map(({ destination, search }) => (
                  <li
                    class="combo-option"
                    id={`compare-option-${destination.key}`}
                    role="option"
                    aria-selected="false"
                    data-combo-option
                    data-key={destination.key}
                    data-name={destination.name[locale]}
                    data-region={destination.region}
                    data-score={destination.score.mean}
                    data-group={category.key}
                    data-search={search}
                  >
                    <span class="text-faint">
                      <Icon name={destinationIcon(destination)} size={15} />
                    </span>
                    <span class="grow truncate">{destination.name[locale]}</span>
                    <span class="flex shrink-0 items-center gap-1.5 text-[0.78rem] text-faint">
                      <RegionMark region={destination.region} size={14} />
                      {destination.region}
                    </span>
                    <span class="num shrink-0 text-[0.82rem] text-muted">
                      {decimal(locale, destination.score.mean, 0)}
                    </span>
                  </li>
                ))}
              </>
            ))
          }
          <li class="combo-empty" role="presentation" data-combo-none hidden>
            {t.compare["no-match"]}
          </li>
        </ul>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="num text-[0.85rem] text-muted" data-compare-count role="status"></span>
        <button
          class="chip gap-1.5"
          type="button"
          data-compare-copy
          data-copied={t.ui.copied}
          data-label={t.compare.copy}
          title={t.compare.copy}
          hidden
        >
          <Icon name="link" size={14} />
          <span>{t.ui.share}</span>
        </button>
        <button class="chip gap-1.5" type="button" data-compare-reset hidden>
          <Icon name="cross" size={13} />
          <span>{t.compare.reset}</span>
        </button>
      </div>
    </div>

    <p class="text-[0.84rem] text-gold-ink" data-compare-full role="status" hidden>
      {t.compare.full}
    </p>
  </div>

  <div class="compare-slots" data-compare-slots></div>

  <div data-compare-loading hidden>
    <p class="mb-3.5 text-[0.9rem] text-muted">{t.compare.loading}</p>
    <Skeleton rows={6} height={26} />
  </div>

  <div data-compare-empty>
    <Panel locale={locale} icon="layers" title={t.compare["empty-title"]} tone="muted" headingLevel={2}>
      <p class="text-muted">{t.compare["empty-body"]}</p>
      <div class="grid gap-2.5 border-t border-line pt-3.5">
        <p class="text-[0.84rem] text-faint">{t.compare.presets}</p>
        <div class="flex flex-wrap gap-2">
          {
            presets.map((preset) => (
              <a
                class="chip h-auto max-w-full min-h-11 gap-2 py-1.5 whitespace-normal"
                href={`${comparePath(locale)}?${preset.keys.map((key) => `d=${key}`).join("&")}`}
                data-preset={preset.keys.join(",")}
              >
                <span class="grid gap-0.5 text-left">
                  <span class="text-[0.72rem] text-faint">{preset.label}</span>
                  <span class="font-bold text-ink">
                    {preset.names[0]}
                    <span class="font-normal text-faint"> vs </span>
                    {preset.names[1]}
                  </span>
                </span>
                <Icon name="arrowRight" size={15} />
              </a>
            ))
          }
        </div>
      </div>
    </Panel>
  </div>

  <div data-compare-one hidden>
    <Panel locale={locale} icon="compass" title={t.compare["one-more-title"]} tone="muted" headingLevel={2}>
      <p class="text-muted">{t.compare["one-more"]}</p>
    </Panel>
  </div>

  <div data-compare-error hidden></div>

  <div class="grid gap-3" data-compare-result hidden>
    <p class="verdict" data-compare-verdict></p>
    <div class="compare-wrap" data-compare-wrap>
      <table class="compare-table" data-compare-table></table>
    </div>
    <p class="text-[0.8rem] text-faint" data-compare-scroll-hint hidden>
      {t.compare["scroll-hint"]}
    </p>
  </div>
</div>

<script>
  import { api } from "../lib/api/client";
  import { renderCompare } from "../lib/compare-table";

  type Labels = Record<string, any>;

  const root = document.querySelector<HTMLElement>("[data-compare]");
  if (root) {
    const labels: Labels = JSON.parse(root.dataset.labels ?? "{}");
    const locale: string = labels.locale ?? document.documentElement.lang ?? "it";
    const LIMIT = 4;

    const input = root.querySelector<HTMLInputElement>("[data-combo-input]")!;
    const list = root.querySelector<HTMLUListElement>("[data-combo-list]")!;
    const none = root.querySelector<HTMLElement>("[data-combo-none]")!;
    const slots = root.querySelector<HTMLElement>("[data-compare-slots]")!;
    const counter = root.querySelector<HTMLElement>("[data-compare-count]")!;
    const fullNote = root.querySelector<HTMLElement>("[data-compare-full]")!;
    const resetButton = root.querySelector<HTMLButtonElement>("[data-compare-reset]")!;
    const copyButton = root.querySelector<HTMLButtonElement>("[data-compare-copy]")!;
    const emptyState = root.querySelector<HTMLElement>("[data-compare-empty]")!;
    const oneState = root.querySelector<HTMLElement>("[data-compare-one]")!;
    const errorState = root.querySelector<HTMLElement>("[data-compare-error]")!;
    const loading = root.querySelector<HTMLElement>("[data-compare-loading]")!;
    const result = root.querySelector<HTMLElement>("[data-compare-result]")!;
    const verdict = root.querySelector<HTMLElement>("[data-compare-verdict]")!;
    const wrap = root.querySelector<HTMLElement>("[data-compare-wrap]")!;
    const table = root.querySelector<HTMLTableElement>("[data-compare-table]")!;

    const optionEls = Array.from(
      list.querySelectorAll<HTMLLIElement>("[data-combo-option]"),
    );
    const headerEls = Array.from(list.querySelectorAll<HTMLLIElement>("[data-combo-header]"));
    const optionByKey = new Map(optionEls.map((el) => [el.dataset.key!, el]));

    const nf = (digits = 0) =>
      new Intl.NumberFormat(locale, { maximumFractionDigits: digits });
    const num = (value: number, digits = 0) => nf(digits).format(value);
    const fill = (template: string, values: Record<string, string | number>) =>
      template.replace(/\{(\w+)\}/g, (_, key: string) =>
        values[key] === undefined ? `{${key}}` : String(values[key]),
      );
    const esc = (value: string) =>
      value.replace(/[&<>"']/g, (char) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]!,
      );

    const ICON_CROSS =
      '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>';
    const ICON_PLUS =
      '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>';

    // Le destinazioni scelte stanno nella URL: un confronto si condivide
    // incollando un link, non ricostruendolo a mano.
    const params = new URLSearchParams(location.search);
    let selected = params
      .getAll("d")
      .flatMap((value) => value.split(","))
      .filter((key) => optionByKey.has(key))
      .filter((key, index, all) => all.indexOf(key) === index)
      .slice(0, LIMIT);

    let request = 0;

    function syncUrl() {
      const next = new URLSearchParams();
      for (const key of selected) next.append("d", key);
      // `_debug` sopravvive alla riscrittura: questa pagina ha uno stato di
      // errore con il pulsante «riprova», e senza tenerlo era l'unica schermata
      // in cui quello stato non si riusciva a mostrare.
      const debug = new URLSearchParams(location.search).get("_debug");
      if (debug) next.set("_debug", debug);
      history.replaceState(null, "", next.toString() ? `?${next}` : location.pathname);
    }

    // ------------------------------------------------------------ combobox
    let open = false;
    let active = -1;

    const visible = () => optionEls.filter((el) => !el.hidden);

    function setOpen(next: boolean) {
      open = next;
      list.hidden = !next;
      input.setAttribute("aria-expanded", String(next));
      if (!next) {
        active = -1;
        input.removeAttribute("aria-activedescendant");
        optionEls.forEach((el) => el.setAttribute("aria-selected", "false"));
      }
    }

    function setActive(index: number) {
      const rows = visible();
      if (!rows.length) return;
      active = (index + rows.length) % rows.length;
      optionEls.forEach((el) => el.setAttribute("aria-selected", "false"));
      const el = rows[active];
      el.setAttribute("aria-selected", "true");
      input.setAttribute("aria-activedescendant", el.id);
      el.scrollIntoView({ block: "nearest" });
    }

    function filter() {
      const term = input.value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
      for (const el of optionEls) {
        const picked = selected.includes(el.dataset.key!);
        el.dataset.picked = String(picked);
        el.hidden = term.length > 0 && !el.dataset.search!.includes(term);
      }
      // Un'intestazione di categoria senza righe sotto è solo rumore.
      for (const header of headerEls) {
        header.hidden = !optionEls.some(
          (el) => !el.hidden && el.dataset.group === header.dataset.comboHeader,
        );
      }
      none.hidden = visible().length > 0;
      active = -1;
      input.removeAttribute("aria-activedescendant");
      optionEls.forEach((el) => el.setAttribute("aria-selected", "false"));
    }

    function pick(key: string) {
      if (!key || selected.includes(key) || selected.length >= LIMIT) return;
      selected.push(key);
      input.value = "";
      filter();
      setOpen(false);
      update();
    }

    input.addEventListener("focus", () => {
      if (selected.length >= LIMIT) return;
      filter();
      setOpen(true);
    });

    input.addEventListener("input", () => {
      filter();
      setOpen(selected.length < LIMIT);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        if (!open) {
          filter();
          setOpen(true);
        }
        setActive(active + (event.key === "ArrowDown" ? 1 : -1));
        return;
      }
      if (event.key === "Enter") {
        const rows = visible();
        const el = active >= 0 ? rows[active] : rows.length === 1 ? rows[0] : undefined;
        if (el) {
          event.preventDefault();
          pick(el.dataset.key!);
        }
        return;
      }
      if (event.key === "Escape") {
        setOpen(false);
        input.value = "";
        filter();
      }
    });

    list.addEventListener("mousedown", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLLIElement>("[data-combo-option]");
      if (!el) return;
      event.preventDefault();
      pick(el.dataset.key!);
    });

    document.addEventListener("click", (event) => {
      if (!open) return;
      if (!root!.querySelector("[data-combo]")!.contains(event.target as Node)) setOpen(false);
    });

    // La lista di scelta porta due svg per riga: l'icona del territorio e la
    // sagoma della regione. Qui ripeschiamo la seconda invece di spedire di
    // nuovo al client i path delle venti regioni.
    const regionMark = (key: string) =>
      optionByKey.get(key)?.querySelectorAll("svg")[1]?.outerHTML ?? "";

    // --------------------------------------------------------------- slot
    function renderSlots() {
      const cards = selected.map((key) => {
        const option = optionByKey.get(key)!;
        const name = option.dataset.name!;
        const icon = option.querySelector("svg")?.outerHTML ?? "";
        return `<div class="slot" data-slot="${esc(key)}">
          <span class="flex items-center gap-2 text-faint">${icon}</span>
          <span class="slot-name">${esc(name)}</span>
          <span class="slot-meta">${regionMark(key)}${esc(option.dataset.region!)} · <span class="num">${num(
            Number(option.dataset.score),
          )}</span></span>
          <button class="slot-remove" type="button" data-remove="${esc(key)}" aria-label="${esc(
            fill(labels.remove, { name }),
          )}" title="${esc(fill(labels.remove, { name }))}">${ICON_CROSS}</button>
        </div>`;
      });

      // Quattro tracce sempre: un invito vero, e i posti ancora liberi come
      // sagome. Il "fino a quattro" si vede, non va letto da nessuna parte.
      if (selected.length < LIMIT) {
        cards.push(
          `<button class="slot slot-empty" type="button" data-slot-add>
            ${ICON_PLUS}<span>${esc(labels.slotAdd)}</span>
          </button>`,
        );
        for (let index = selected.length + 1; index < LIMIT; index += 1) {
          cards.push('<span class="slot-ghost" aria-hidden="true"></span>');
        }
      }

      slots.innerHTML = cards.join("");

      slots.querySelectorAll<HTMLButtonElement>("[data-remove]").forEach((button) => {
        button.addEventListener("click", () => {
          selected = selected.filter((key) => key !== button.dataset.remove);
          update();
        });
      });
      slots.querySelectorAll<HTMLButtonElement>("[data-slot-add]").forEach((button) => {
        button.addEventListener("click", (event) => {
          // Senza questo, il gestore che chiude la lista al click fuori la
          // richiuderebbe nello stesso giro di eventi.
          event.stopPropagation();
          input.focus();
          filter();
          setOpen(true);
        });
      });

      filter();
      counter.textContent = fill(labels.count, { n: selected.length });
      fullNote.hidden = selected.length < LIMIT;
      resetButton.hidden = selected.length === 0;
      copyButton.hidden = selected.length < 2;
      input.disabled = selected.length >= LIMIT;
    }

    resetButton.addEventListener("click", () => {
      selected = [];
      input.value = "";
      filter();
      update();
      input.focus();
    });

    copyButton.addEventListener("click", async () => {
      const span = copyButton.querySelector("span")!;
      const previous = span.textContent;
      try {
        await navigator.clipboard.writeText(location.href);
        span.textContent = copyButton.dataset.copied ?? "";
        copyButton.setAttribute("data-active", "true");
        setTimeout(() => {
          span.textContent = previous;
          copyButton.removeAttribute("data-active");
        }, 1800);
      } catch {
        // Senza permesso sugli appunti resta comunque la URL nella barra.
      }
    });

    // -------------------------------------------------------------- tabella
    type Row = any;

    const scrollHint = root.querySelector<HTMLElement>("[data-compare-scroll-hint]")!;

    wrap.addEventListener("scroll", () => {
      wrap.dataset.scrolled = String(wrap.scrollLeft > 2);
    });

    // Il suggerimento compare solo se c'è davvero qualcosa fuori dallo schermo.
    function syncScrollHint() {
      scrollHint.hidden = wrap.scrollWidth <= wrap.clientWidth + 2;
    }

    addEventListener("resize", syncScrollHint);

    function showError() {
      errorState.innerHTML = `<div class="grid gap-3 rounded-(--radius-brand) border border-gold/40 bg-gold/10 p-[18px]">
        <strong>${esc(labels.errorTitle)}</strong>
        <p class="text-[0.9rem] text-muted">${esc(labels.errorBody)}</p>
        <span><button class="btn btn-secondary" type="button" data-compare-retry>${esc(labels.retry)}</button></span>
      </div>`;
      errorState.hidden = false;
      errorState
        .querySelector<HTMLButtonElement>("[data-compare-retry]")
        ?.addEventListener("click", () => update());
    }

    async function update() {
      renderSlots();
      syncUrl();
      errorState.hidden = true;

      if (selected.length < 2) {
        emptyState.hidden = selected.length !== 0;
        oneState.hidden = selected.length !== 1;
        loading.hidden = true;
        result.hidden = true;
        return;
      }

      emptyState.hidden = true;
      oneState.hidden = true;
      const ticket = (request += 1);
      loading.hidden = false;
      result.hidden = true;
      try {
        // Una chiamata per destinazione, in parallelo: la stessa cosa che farà
        // il backend quando esisterà.
        const rows = await api.compare(selected);
        if (ticket !== request) return;
        const built = renderCompare(
          rows.map((row: any) => ({ ...row, name: row.name[locale] ?? row.name.it })),
          labels,
          locale,
          { regionMark },
        );
        table.innerHTML = built.table;
        verdict.innerHTML = built.verdict;
        result.hidden = false;
        syncScrollHint();
      } catch {
        if (ticket !== request) return;
        showError();
      } finally {
        if (ticket === request) loading.hidden = true;
      }
    }

    // I link "parti da qui" restano link veri (funzionano anche condivisi),
    // ma da dentro la pagina non serve ricaricare tutto.
    root.querySelectorAll<HTMLAnchorElement>("[data-preset]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        selected = (link.dataset.preset ?? "").split(",").filter(Boolean).slice(0, LIMIT);
        update();
      });
    });

    filter();
    update();
  }
</script>
