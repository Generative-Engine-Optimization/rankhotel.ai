---
const {
  values,
  width = 88,
  height = 26,
  tone = "accent",
} = Astro.props as {
  values: number[];
  width?: number;
  height?: number;
  tone?: "accent" | "muted";
};

// SVG generato a build time: nessuna libreria di charting, nessun JS, e si
// tematizza con i token come tutto il resto.
const min = Math.min(...values);
const max = Math.max(...values);
const span = max - min || 1;
const step = values.length > 1 ? width / (values.length - 1) : width;
const points = values
  .map((value, index) => {
    const x = index * step;
    const y = height - 2 - ((value - min) / span) * (height - 4);
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  })
  .join(" ");
const stroke = tone === "accent" ? "var(--color-accent)" : "var(--color-faint)";
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  fill="none"
  aria-hidden="true"
  class="overflow-visible"
>
  <polyline
    points={points}
    stroke={stroke}
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
