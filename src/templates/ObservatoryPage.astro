---
import CrawlerMark from "../components/CrawlerMark.astro";
import CtaBlock from "../components/CtaBlock.astro";
import DestinationTable from "../components/DestinationTable.astro";
import EngineCards from "../components/EngineCards.astro";
import Icon from "../components/Icon.astro";
import MapIsland from "../components/MapIsland.astro";
import PageHero from "../components/PageHero.astro";
import Panel from "../components/Panel.astro";
import ScoreBreakdown from "../components/ScoreBreakdown.astro";
import ScoreDial from "../components/ScoreDial.astro";
import Section from "../components/Section.astro";
import SourceMix from "../components/SourceMix.astro";
import StatGrid from "../components/StatGrid.astro";
import TierBadge from "../components/TierBadge.astro";
import ObsLayout from "../layouts/ObsLayout.astro";
import {
  assumptionsPath,
  categoryPath,
  comparePath,
  destinationPath,
  glossaryPath,
  hotelsIndexPath,
  mapPath,
  methodologyPath,
  observatoryPath,
  otherLocale,
  queriesPath,
  tagPath,
  tagsPath,
  type Locale,
} from "../lib/config";
import { decimal, number, percent, signed } from "../lib/format";
import { messages } from "../lib/i18n";
import {
  ENGINES,
  META,
  NATIONAL,
  comparePairs,
  engineMeta,
  listCategories,
  listDestinations,
  listTags,
  rankDestinationsBy,
  topHotels,
} from "../lib/observatory";
import { datasetSchema } from "../lib/schema";

const { locale } = Astro.props as { locale: Locale };
const other = otherLocale(locale);
const t = messages(locale).observatory;

const categories = listCategories();
const destinations = listDestinations();
const ranked = rankDestinationsBy("all");
const tags = listTags().slice(0, 8);

// Due confronti già impostati: dalla classifica la domanda successiva è quasi
// sempre "e questi due come stanno uno accanto all'altro?".
const comparePresets = comparePairs()
  .slice(0, 2)
  .map(({ pair }) => ({
    href: `${comparePath(locale)}?${pair.map((row) => `d=${row.key}`).join("&")}`,
    names: pair.map((row) => row.name[locale]),
  }));

const nationalStat = {
  mean: NATIONAL.score,
  stdDev: 0,
  min: NATIONAL.score,
  max: NATIONAL.score,
  runs: NATIONAL.runsPerMonth,
  stability: "stable" as const,
};

const schema = datasetSchema(
  locale,
  t.meta.title,
  t.meta.description,
  observatoryPath(locale),
);
---

<ObsLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  path={observatoryPath(locale)}
  altPath={observatoryPath(other)}
  schema={schema}
  breadcrumb={false}
>
  <PageHero
    locale={locale}
    eyebrow={t.hero.eyebrow}
    icon="chart"
    title={t.hero.title}
    lead={t.hero.lead}
  >
    <StatGrid
      locale={locale}
      columns={4}
      items={[
        { label: t.stats.destinations, value: number(locale, NATIONAL.destinations) },
        { label: t.stats.hotels, value: number(locale, NATIONAL.hotelsTracked) },
        { label: t.stats.sites, value: number(locale, NATIONAL.sitesAudited) },
        {
          label: t.stats.responses,
          value: number(locale, NATIONAL.responsesAnalyzed),
          hint: t.ui["measured-since"],
          info: t.explain.runs,
        },
      ]}
    />
    <div class="flex flex-wrap gap-2.5">
      <a class="btn gap-2" href="#classifica">
        {t.hero["cta-explore"]}
        <Icon name="arrowDown" size={17} />
      </a>
      <a class="btn btn-secondary gap-2" href={mapPath(locale)}>
        <Icon name="pin" size={16} />
        {t.hero["cta-map"]}
      </a>
      <a class="btn btn-secondary gap-2" href={glossaryPath(locale)}>
        <Icon name="info" size={16} />
        {t.ui.glossary}
      </a>
    </div>
  </PageHero>

  <Section
    locale={locale}
    id="italia"
    title={t.national.title}
    lead={t.national.lead}
    info={t.explain.score}
  >
    <div class="grid items-start gap-[34px] lg:grid-cols-[5fr_7fr]">
      <Panel locale={locale}>
        <div class="tricolore-edge grid gap-1">
          <span class="text-[0.85rem] text-muted">{t.score.national}</span>
          <ScoreDial locale={locale} stat={nationalStat} size="lg" showBand={false} />
        </div>
        <ScoreBreakdown locale={locale} factors={NATIONAL.factors} compact />
        <a class="inline-flex items-center gap-1.5 text-accent-ink" href={methodologyPath(locale)}>
          {t.factors.title}
          <Icon name="arrowRight" size={15} />
        </a>
      </Panel>
      <div class="grid gap-3.5">
        <EngineCards
          locale={locale}
          byEngine={Object.fromEntries(
            ENGINES.map((engine) => [engine, { score: NATIONAL.byEngine[engine] }]),
          )}
          overall={NATIONAL.score}
        />
        <Panel locale={locale} title={t.sources.title} lead={t.sources["lead-national"]} icon="quote">
          <SourceMix locale={locale} byKind={NATIONAL.sourceMix} />
        </Panel>
      </div>
    </div>
  </Section>

  <Section
    locale={locale}
    id="categorie"
    title={t.national["categories-title"]}
    lead={t.national["categories-lead"]}
  >
    <div class="grid gap-3.5 md:grid-cols-2 xl:grid-cols-3">
      {
        categories.map((category) => (
          <a
            class="card lift grid content-start gap-3.5"
            href={categoryPath(locale, category.slug[locale])}
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="flex items-center gap-2.5">
                <span class="cat-ink" data-cat={category.key}>
                  <Icon name={category.icon} size={22} />
                </span>
                {category.name[locale]}
              </h3>
              <span class="dial text-[1.3rem]">
                <span class="dial-value">{decimal(locale, category.score, 0)}</span>
              </span>
            </div>
            <p class="text-[0.92rem] text-muted">{category.lead[locale]}</p>
            <div class="flex flex-wrap gap-2">
              <span class="pill num">
                {category.size} {t.stats.destinations}
              </span>
              <span class="pill num">
                {number(locale, category.hotelsTracked)} {t.stats.hotels}
              </span>
            </div>
          </a>
        ))
      }
      <Panel locale={locale} tone="muted" title={t.compare.title} lead={t.compare.lead} icon="layers">
        <a class="btn btn-secondary justify-self-start gap-2" href={comparePath(locale)}>
          {t.compare.cta}
          <Icon name="arrowRight" size={16} />
        </a>
      </Panel>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[0.85rem] text-muted">{t.tags.title}:</span>
      {
        tags.map((tag) => (
          <a class="chip gap-1.5" href={tagPath(locale, tag.slug[locale])}>
            <Icon name="tag" size={13} />
            {tag.name[locale]}
            <span class="num text-faint">{tag.count}</span>
          </a>
        ))
      }
      <a class="chip gap-1.5 text-accent-ink" href={tagsPath(locale)}>
        {t.tags.all}
        <Icon name="arrowRight" size={13} />
      </a>
    </div>
  </Section>

  <Section
    locale={locale}
    id="classifica"
    eyebrow={t.score.label}
    title={t.national.leaderboard}
    lead={t.engines.lead}
  >
    <DestinationTable locale={locale} destinations={ranked} showCategory />

    <div
      class="grid items-center gap-x-[38px] gap-y-[18px] rounded-(--radius-brand) border border-line-strong bg-surface-muted p-[22px] lg:grid-cols-[1fr_auto]"
    >
      <div class="grid gap-2">
        <h3 class="flex items-center gap-2.5">
          <span class="text-accent-ink"><Icon name="layers" size={20} /></span>
          {t.compare.title}
        </h3>
        <p class="text-[0.94rem] text-muted">{t.compare.lead}</p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          <span class="text-[0.82rem] text-faint">{t.compare.ready}</span>
          {
            comparePresets.map((preset) => (
              <a
                class="chip gap-1.5"
                href={preset.href}
                aria-label={`${preset.names[0]} vs ${preset.names[1]}`}
              >
                <span class="font-bold text-ink">{preset.names[0]}</span>
                <span class="text-faint">vs</span>
                <span class="font-bold text-ink">{preset.names[1]}</span>
              </a>
            ))
          }
        </div>
      </div>
      <a class="btn gap-2 lg:justify-self-end" href={comparePath(locale)}>
        {t.compare.cta}
        <Icon name="arrowRight" size={17} />
      </a>
    </div>
  </Section>

  <Section locale={locale} id="mappa" title={t.map.title} lead={t.map.lead}>
    <MapIsland locale={locale} destinations={destinations} height={520} />
    <div class="flex flex-wrap gap-2.5">
      <a class="btn btn-secondary gap-2" href={mapPath(locale)}>
        <Icon name="pin" size={16} />
        {t.hero["cta-map"]}
      </a>
      <a class="btn btn-secondary gap-2" href={queriesPath(locale)}>
        <Icon name="search" size={16} />
        {t.queries.explore}
      </a>
    </div>
  </Section>

  <Section
    locale={locale}
    id="hotel"
    title={t.hotelsPage.title}
    lead={t.hotelsPage.lead}
  >
    <div class="grid items-start gap-[34px] lg:grid-cols-[5fr_7fr]">
      <Panel locale={locale} icon="hotel">
        <StatGrid
          locale={locale}
          columns={2}
          size="sm"
          items={[
            { label: t.stats.hotels, value: number(locale, NATIONAL.hotelsTracked) },
            {
              label: t.hotelsPage.real,
              value: number(locale, NATIONAL.hotelsReal),
              hint: t.hotelsPage["real-lead"],
            },
          ]}
        />
        <a class="btn btn-secondary justify-self-start gap-2" href={hotelsIndexPath(locale)}>
          {t.hotelsPage.national}
          <Icon name="arrowRight" size={16} />
        </a>
      </Panel>
      <div class="table-wrap table-dense">
        <table>
          <thead>
            <tr>
              <th scope="col" class="w-10">#</th>
              <th scope="col">
                <span class="th-label"><Icon name="hotel" size={13} />{t.table.hotel}</span>
              </th>
              <th scope="col">
                <span class="th-label"><Icon name="territory" size={13} />{t.table.destination}</span>
              </th>
              <th scope="col" class="text-right">{t.table.score}</th>
            </tr>
          </thead>
          <tbody>
            {
              topHotels()
                .filter((hotel) => hotel.confidence !== "generated")
                .slice(0, 8)
                .map((hotel, index) => (
                  <tr>
                    <td class="num text-faint">{index + 1}</td>
                    <td>
                      <span class="font-bold">{hotel.name}</span>
                      <span class="block text-[0.78rem] text-muted">
                        {"★".repeat(hotel.stars)}
                      </span>
                    </td>
                    <td class="text-[0.86rem] text-muted">{hotel.destinationName[locale]}</td>
                    <td class="num text-right">{decimal(locale, hotel.score.mean, 0)}</td>
                  </tr>
                ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <Section
    locale={locale}
    id="bot"
    title={t.national["crawl-title"]}
    lead={t.national["crawl-lead"]}
  >
    <div class="grid gap-3.5 md:grid-cols-2 xl:grid-cols-4">
      {
        META.crawlers.map((crawler) => {
          const row = NATIONAL.crawlers[crawler.key];
          return (
            <Panel locale={locale}>
              <div class="flex items-baseline justify-between gap-2">
                <strong class="num flex items-center gap-1.5 text-[0.94rem]">
                  <CrawlerMark engine={crawler.engine} size={15} />
                  {crawler.key}
                </strong>
                <span class="num text-danger-ink">{percent(locale, row.block)}</span>
              </div>
              <span class="bar bar-low">
                <span style={`width:${Math.max(2, row.block * 100)}%`} />
              </span>
              <p class="text-[0.82rem] text-muted">
                {crawler.engine ? engineMeta(crawler.engine)?.label : "Common Crawl"} ·{" "}
                {crawler.purpose[locale]}
              </p>
            </Panel>
          );
        })
      }
    </div>
  </Section>

  <Section locale={locale} id="movimenti" title={t.national.rising} share={false}>
    <div class="grid gap-3.5 lg:grid-cols-2">
      {
        [
          { title: t.national.rising, rows: NATIONAL.topRising.slice(0, 5), up: true },
          { title: t.national.falling, rows: NATIONAL.topFalling.slice(0, 5), up: false },
        ].map((block) => (
          <Panel locale={locale} title={block.title} icon={block.up ? "arrowUp" : "arrowDown"}>
            <ul class="grid gap-2">
              {block.rows.map((row) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-line pb-2 last:border-0 last:pb-0">
                  <span>{row.name[locale]}</span>
                  <span class={`num ${block.up ? "text-success-ink" : "text-danger-ink"}`}>
                    {signed(row.trend, 1)}
                  </span>
                </li>
              ))}
            </ul>
          </Panel>
        ))
      }
    </div>
  </Section>

  <section class="section">
    <div class="shell">
      <CtaBlock
        title={t.cta.title}
        body={t.cta.body}
        primary={{ label: t.hero["cta-map"], href: mapPath(locale) }}
        secondary={[
          { label: t.compare.cta, href: comparePath(locale) },
          { label: t.assumptions.title, href: assumptionsPath(locale) },
          { label: t.methodology.title, href: methodologyPath(locale) },
        ]}
      />
    </div>
  </section>
</ObsLayout>
