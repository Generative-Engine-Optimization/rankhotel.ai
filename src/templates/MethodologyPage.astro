---
import CtaBlock from "../components/CtaBlock.astro";
import EngineLogo from "../components/EngineLogo.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import FunnelTag from "../components/FunnelTag.astro";
import Panel from "../components/Panel.astro";
import ScoreBreakdown from "../components/ScoreBreakdown.astro";
import Section from "../components/Section.astro";
import StatGrid from "../components/StatGrid.astro";
import TierBadge from "../components/TierBadge.astro";
import Toc from "../components/Toc.astro";
import ObsLayout from "../layouts/ObsLayout.astro";
import {
  DEMO_DISCLOSURE,
  assumptionsPath,
  glossaryPath,
  methodologyPath,
  observatoryPath,
  otherLocale,
  type Locale,
} from "../lib/config";
import { number } from "../lib/format";
import { faqSchema } from "../lib/schema";
import { interpolate, messages } from "../lib/i18n";
import {
  ENGINES,
  FACTOR_KEYS,
  META,
  NATIONAL,
  SCORE_WEIGHTS,
  engineMeta,
  funnelStages,
  listPrompts,
} from "../lib/observatory";

const { locale } = Astro.props as { locale: Locale };
const other = otherLocale(locale);
const t = messages(locale).observatory;
const stages = funnelStages();

// I pesi vengono letti dal codice che li applica: la formula pubblicata e
// quella calcolata non possono divergere.
const demoFactors = Object.fromEntries(
  FACTOR_KEYS.map((key) => [key, SCORE_WEIGHTS[key] * 2.6]),
) as Record<(typeof FACTOR_KEYS)[number], number>;

const factorIcon = {
  comparative: "compass",
  internal: "layers",
  sources: "quote",
  technical: "robot",
} as const;

// Queste quattro spiegazioni stavano tutte dentro la sezione sugli assistenti,
// che parlava d'altro: chi cercava "perché cinque rilevazioni" non aveva modo
// di trovarlo, né dall'indice né scorrendo. Ora ognuna è una sezione con la sua
// ancora; qui restano solo per lo schema FAQ, che le rende citabili una a una.
const faqBlocks = [
  { title: t.methodology["levels-title"], body: t.methodology["levels-body"] },
  { title: t.methodology["runs-title"], body: t.methodology["runs-body"] },
  { title: t.methodology["engines-title"], body: t.methodology["engines-body"] },
  { title: t.methodology["technical-title"], body: t.methodology["technical-body"] },
];

// I due tipi di domanda alimentano due fattori diversi del punteggio. Il nesso
// era scritto da nessuna parte: si diceva che esistono due livelli, e altrove
// che esistono quattro fattori, senza mai legarli. I conteggi si contano dai
// template veri, così non possono divergere da quello che viene chiesto.
const prompts = listPrompts();
const levels = [
  {
    key: "comparative" as const,
    label: t.methodology["level-comparative"],
    icon: "compass",
    n: prompts.filter((prompt) => prompt.level === "comparative").length,
  },
  {
    key: "internal" as const,
    label: t.methodology["level-internal"],
    icon: "layers",
    n: prompts.filter((prompt) => prompt.level === "internal").length,
  },
];

// I quattro blocchi qui sotto e le spiegazioni dei fattori sono già scritti
// come domanda e risposta: dichiararli FAQ rende ogni risposta citabile da sola
// da un motore generativo, senza che debba ricostruirla dal testo intorno.
const faq = faqSchema(methodologyPath(locale), [
  ...faqBlocks.map((block) => ({ question: block.title, answer: block.body })),
  ...FACTOR_KEYS.map((key) => ({
    question: t.factors[key].name,
    answer: t.explain[key],
  })),
]);

// L'indice segue l'ordine in cui le domande vengono in mente: cosa misurate,
// cosa chiedete, quante volte, a chi, e poi come si legge il numero che esce.
const sections = [
  { id: "formula", label: t.methodology["formula-title"], icon: "chart" },
  { id: "domande", label: t.methodology["levels-title"], icon: "quote" },
  { id: "rilevazioni", label: t.methodology["runs-title"], icon: "calendar" },
  { id: "engine", label: t.engines.title, icon: "robot" },
  { id: "tecnica", label: t.methodology["technical-title"], icon: "globe" },
  { id: "fasce", label: t.rank["tiers-title"], icon: "layers" },
  { id: "funnel", label: t.funnel.title, icon: "route" },
  { id: "numeri", label: t.methodology["numbers-title"], icon: "info" },
];
---

<ObsLayout
  locale={locale}
  title={t.meta["methodology-title"]}
  description={t.meta["methodology-description"]}
  schema={faq}
  path={methodologyPath(locale)}
  altPath={methodologyPath(other)}
>
  <PageHero
    locale={locale}
    eyebrow={t.nav.methodology}
    icon="chart"
    title={t.methodology.title}
    lead={t.methodology.lead}
    breadcrumb={[
      { label: t.nav.observatory, href: observatoryPath(locale) },
      { label: t.nav.methodology },
    ]}
  >
    <div class="flex flex-wrap gap-2.5">
      <a class="btn btn-secondary" href={glossaryPath(locale)}>
        <Icon name="info" size={16} />
        {t.ui.glossary}
      </a>
      <a class="btn btn-secondary" href={assumptionsPath(locale)}>
        {t.assumptions.title}
        <Icon name="arrowRight" size={16} />
      </a>
    </div>
  </PageHero>

  {/* La risposta breve prima della pagina lunga: chi arriva qui con una domanda
      sola la trova in quattro righe, e un motore generativo ha un blocco
      citabile invece di doverlo ricostruire dal testo intorno. */}
  <div class="shell grid gap-3.5 pb-[34px]">
    <Panel locale={locale} icon="compass" title={t.methodology["summary-title"]} tone="muted">
      <dl class="grid gap-x-8 gap-y-3.5 sm:grid-cols-2">
        {
          t.methodology.summary.map((row) => (
            <div class="grid gap-1">
              <dt class="text-[0.8rem] font-bold tracking-widest text-accent-ink uppercase">
                {row.q}
              </dt>
              <dd class="text-[0.94rem] text-muted">
                {interpolate(row.a, {
                  prompts: prompts.length,
                  engines: ENGINES.length,
                  runs: META.runsPerMonth,
                })}
              </dd>
            </div>
          ))
        }
      </dl>
    </Panel>

    {/* Stava in fondo, nell'ultima sezione. È l'avvertenza che cambia come si
        legge tutto quello che c'è sopra: sopra ci deve stare. */}
    {DEMO_DISCLOSURE && (
    <Panel locale={locale} tone="warn" title={t.methodology["data-title"]} icon="info">
      <p class="text-muted">{t.methodology["data-body"]}</p>
      <a class="inline-flex items-center gap-1.5 text-accent-ink" href={assumptionsPath(locale)}>
        {t.assumptions.title}
        <Icon name="arrowRight" size={15} />
      </a>
    </Panel>
    )}
  </div>

  <div class="shell with-toc block-end">
    <Toc locale={locale} items={sections} />

    <div class="grid gap-0">
      <Section
        locale={locale}
        id="formula"
        title={t.methodology["formula-title"]}
        lead={t.explain.score}
        bare
      >
        <div class="grid items-start gap-[34px] lg:grid-cols-[5fr_7fr]">
          <Panel locale={locale}>
            <p class="font-mono text-[0.86rem] leading-relaxed text-muted">
              {FACTOR_KEYS.map((key) => `${SCORE_WEIGHTS[key]}% ${t.factors[key].name}`).join(" + ")}
            </p>
            <ScoreBreakdown locale={locale} factors={demoFactors} compact />
            <p class="text-[0.8rem] text-faint">{t.methodology["formula-example"]}</p>
          </Panel>
          <div class="grid gap-3.5">
            {
              FACTOR_KEYS.map((key) => (
                <Panel locale={locale} icon={factorIcon[key]} title={t.factors[key].name}>
                  <p class="text-muted">{t.explain[key]}</p>
                  <p class="num text-[0.82rem] text-faint">
                    {t.factors.weight.replace("{n}", String(SCORE_WEIGHTS[key]))}
                  </p>
                </Panel>
              ))
            }
          </div>
        </div>
      </Section>

      <Section
        locale={locale}
        id="domande"
        title={t.methodology["levels-title"]}
        lead={t.methodology["levels-body"]}
      >
        <div class="grid gap-3.5 md:grid-cols-2">
          {
            levels.map((level) => (
              <Panel locale={locale} icon={level.icon} title={level.label}>
                <p class="text-muted">{t.factors[level.key].help}</p>
                <div class="grid gap-1 border-t border-line pt-3.5 text-[0.86rem]">
                  <p class="font-bold">
                    {interpolate(t.methodology["level-feeds"], {
                      factor: t.factors[level.key].name,
                    })}
                  </p>
                  <p class="num text-muted">
                    {interpolate(t.methodology["level-count"], {
                      n: level.n,
                      total: prompts.length,
                    })}
                  </p>
                </div>
              </Panel>
            ))
          }
        </div>
      </Section>

      <Section
        locale={locale}
        id="rilevazioni"
        title={t.methodology["runs-title"]}
        lead={t.methodology["runs-body"]}
      />

      <Section locale={locale} id="engine" title={t.engines.title} lead={t.explain.engines}>
        <div class="grid gap-3.5 sm:grid-cols-3">
          {
            ENGINES.map((engine) => {
              const meta = engineMeta(engine)!;
              return (
                <Panel locale={locale}>
                  <strong><EngineLogo engine={engine} size={22} /></strong>
                  <ul class="grid gap-1">
                    {meta.crawlers.map((crawler) => (
                      <li class="num text-[0.84rem] text-muted">{crawler}</li>
                    ))}
                  </ul>
                </Panel>
              );
            })
          }
        </div>
        <p class="max-w-[820px] text-muted">{t.methodology["engines-body"]}</p>
      </Section>

      <Section
        locale={locale}
        id="tecnica"
        title={t.methodology["technical-title"]}
        lead={t.methodology["technical-body"]}
      />

      <Section
        locale={locale}
        id="fasce"
        title={t.rank["tiers-title"]}
        lead={t.rank["tiers-lead"]}
      >
        <div class="grid gap-2.5">
          {
            META.tiers.map((tier, index) => {
              const next = META.tiers[index - 1];
              return (
                <div class="card flex flex-wrap items-center justify-between gap-3.5">
                  <TierBadge locale={locale} tier={tier.key} />
                  <span class="num text-[0.9rem] text-muted">
                    {next ? `${tier.min}–${next.min}` : `${tier.min}+`}
                  </span>
                </div>
              );
            })
          }
        </div>
        <Panel locale={locale} title={t.demand.title} lead={t.explain.demand} icon="search">
          <ul class="grid gap-1.5">
            {
              META.demandTiers.map((tier, index) => {
                const next = META.demandTiers[index - 1];
                return (
                  <li class="flex items-baseline justify-between gap-3 border-b border-line pb-1.5 last:border-0">
                    <span>{tier.name[locale]}</span>
                    <span class="num text-[0.88rem] text-muted">
                      {next
                        ? `${number(locale, tier.min)}–${number(locale, next.min)}`
                        : `${number(locale, tier.min)}+`}
                    </span>
                  </li>
                );
              })
            }
          </ul>
        </Panel>
      </Section>

      <Section locale={locale} id="funnel" title={t.funnel.title} lead={t.explain.funnel}>
        <div class="grid gap-3.5 md:grid-cols-3">
          {
            stages.map((stage) => (
              <div data-funnel={stage.key}>
                <Panel
                  locale={locale}
                  tone={stage.inScope ? "default" : "muted"}
                  class={stage.inScope ? "funnel-panel h-full" : "h-full"}
                >
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <FunnelTag
                      locale={locale}
                      funnel={stage.key}
                      size={18}
                      class="text-[1.02rem] font-bold"
                    />
                    {!stage.inScope && <span class="pill">{t.funnel["out-of-scope"]}</span>}
                  </div>
                  <p class="text-[0.9rem] text-muted">{stage.lead[locale]}</p>
                </Panel>
              </div>
            ))
          }
        </div>
      </Section>

      <Section
        locale={locale}
        id="numeri"
        title={t.methodology["numbers-title"]}
        lead={t.explain.runs}
      >
        <StatGrid
          locale={locale}
          columns={4}
          items={[
            { label: t.stats.prompts, value: number(locale, listPrompts().length) },
            { label: t.stats.runs, value: number(locale, META.runsPerMonth) },
            { label: t.stats.engines, value: number(locale, ENGINES.length) },
            {
              label: t.stats.responses,
              value: number(locale, NATIONAL.responsesAnalyzed),
              hint: t.ui["measured-since"],
            },
          ]}
        />
      </Section>
    </div>
  </div>

  <section class="section">
    <div class="shell">
      <CtaBlock
        title={t.cta.title}
        body={t.cta.body}
        primary={{ label: t.cta.button, href: observatoryPath(locale) }}
        secondary={[{ label: t.destination.back, href: observatoryPath(locale) }]}
      />
    </div>
  </section>
</ObsLayout>
