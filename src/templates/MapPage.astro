---
import CtaBlock from "../components/CtaBlock.astro";
import Icon from "../components/Icon.astro";
import MapIsland from "../components/MapIsland.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import StatGrid from "../components/StatGrid.astro";
import TierBadge from "../components/TierBadge.astro";
import ObsLayout from "../layouts/ObsLayout.astro";
import {
  categoryPath,
  destinationPath,
  mapPath,
  observatoryPath,
  otherLocale,
  type Locale,
} from "../lib/config";
import { compact, decimal, number } from "../lib/format";
import { messages } from "../lib/i18n";
import { datasetSchema } from "../lib/schema";
import { NATIONAL, destinationsOf, listCategories, listDestinations } from "../lib/observatory";

const { locale } = Astro.props as { locale: Locale };
const other = otherLocale(locale);
const t = messages(locale).observatory;
const categories = listCategories();
const destinations = listDestinations();
---

<ObsLayout
  locale={locale}
  title={t.meta["map-title"]}
  description={t.meta["map-description"]}
  schema={datasetSchema(locale, t.meta["map-title"], t.meta["map-description"], mapPath(locale))}
  path={mapPath(locale)}
  altPath={mapPath(other)}
>
  <PageHero
    locale={locale}
    eyebrow={t.nav.map}
    icon="pin"
    title={t.map["page-title"]}
    lead={t.map.lead}
    breadcrumb={[
      { label: t.nav.observatory, href: observatoryPath(locale) },
      { label: t.nav.map },
    ]}
    compact
  >
    <StatGrid
      locale={locale}
      columns={3}
      size="sm"
      items={[
        { label: t.stats.destinations, value: number(locale, destinations.length) },
        {
          label: t.table.visitors,
          value: compact(locale, destinations.reduce((s, d) => s + d.visitors, 0) * 1000),
        },
        {
          label: t.score.national,
          value: decimal(locale, NATIONAL.score, 0),
        },
      ]}
    />
  </PageHero>

  <section class="shell block-end">
    <span class="tricolore mb-3.5 rounded-full" aria-hidden="true"></span>
    <MapIsland locale={locale} destinations={destinations} height={620} />
  </section>

  <Section
    locale={locale}
    id="elenco"
    title={t.map["list-title"]}
    lead={t.national["categories-lead"]}
  >
    <div class="grid gap-[34px]">
      {
        categories.map((category) => (
          <div class="grid gap-3.5">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h3 class="flex items-center gap-2.5">
                <span class="cat-ink" data-cat={category.key}>
                  <Icon name={category.icon} size={20} />
                </span>
                <a
                  class="hover:text-accent-ink"
                  href={categoryPath(locale, category.slug[locale])}
                >
                  {category.name[locale]}
                </a>
              </h3>
              <span class="num text-[0.86rem] text-muted">
                {decimal(locale, category.score, 0)} · {category.size} {t.stats.destinations}
              </span>
            </div>
            <ul class="grid gap-x-6 gap-y-1 sm:grid-cols-2 xl:grid-cols-3">
              {destinationsOf(category.key).map((destination) => (
                <li class="flex items-center justify-between gap-3 border-b border-line py-2">
                  <a
                    class="hover:text-accent-ink"
                    href={destinationPath(locale, destination.slug[locale])}
                  >
                    {destination.name[locale]}
                  </a>
                  <span class="flex items-center gap-2.5">
                    <TierBadge locale={locale} tier={destination.tier} size="sm" />
                    <span class="num text-[0.84rem] text-muted">
                      {decimal(locale, destination.score.mean, 0)}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <section class="section">
    <div class="shell">
      <CtaBlock
        title={t.cta.title}
        body={t.cta.body}
        primary={{ label: t.cta.button, href: observatoryPath(locale) }}
        secondary={[{ label: t.destination.back, href: observatoryPath(locale) }]}
      />
    </div>
  </section>
</ObsLayout>
