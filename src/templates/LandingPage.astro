---
import EngineLogo from "../components/EngineLogo.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import Panel from "../components/Panel.astro";
import Section from "../components/Section.astro";
import ScoreBreakdown from "../components/ScoreBreakdown.astro";
import SiteShell from "../components/SiteShell.astro";
import StatGrid from "../components/StatGrid.astro";
import TierBadge from "../components/TierBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  BRAND,
  LINKS,
  categoryPath,
  glossaryPath,
  hotelsIndexPath,
  mapPath,
  methodologyPath,
  observatoryPath,
  otherLocale,
  pathFor,
  queriesPath,
  sitemapPath,
  type Locale,
} from "../lib/config";
import { decimal, number } from "../lib/format";
import { messages } from "../lib/i18n";
import {
  ENGINES,
  FACTOR_KEYS,
  META,
  NATIONAL,
  listCategories,
  listPrompts,
} from "../lib/observatory";
import {
  datasetSchema,
  faqSchema,
  graph,
  organizationSchema,
  webPageSchema,
  webSiteSchema,
} from "../lib/schema";

const { locale } = Astro.props as { locale: Locale };
const other = otherLocale(locale);
const m = messages(locale);
const landing = m.landing;
const t = m.observatory;

const categories = listCategories();
const hrefs = [
  { locale: "it" as const, href: "/it" },
  { locale: "en" as const, href: "/en" },
];

const factorIcon = {
  comparative: "compass",
  internal: "layers",
  sources: "quote",
  technical: "robot",
} as const;

const stepIcons = ["prompt", "repeat", "browser", "gauge"];

const startLinks = [
  { href: mapPath(locale), icon: "pin" },
  { href: observatoryPath(locale), icon: "chart" },
  { href: hotelsIndexPath(locale), icon: "hotel" },
  { href: methodologyPath(locale), icon: "info" },
];

// Le tre cose da sapere prima di leggere un numero. Sono le stesse spiegazioni
// che compaiono nei tooltip dentro l'osservatorio: qui stanno insieme, perché
// chi arriva per la prima volta le deve incontrare tutte e tre.
const readingRules = [
  { title: t.score.label, body: t.explain.score, icon: "chart" },
  { title: t.rank.tier, body: t.explain.tier, icon: "layers" },
  { title: t.ui["runs-title"], body: t.explain.runs, icon: "calendar" },
];

// La home è il posto in cui si dichiara l'entità: chi pubblica, che sito è,
// che dataset contiene. Le altre pagine ci si agganciano per @id.
// Le tre regole di lettura sono già domande e risposte: dichiararle come FAQ è
// il formato che i motori generativi estraggono meglio.
const schema = graph([
  organizationSchema(locale),
  webSiteSchema(locale),
  webPageSchema(locale, {
    title: landing.meta.title,
    description: landing.meta.description,
    path: pathFor(locale),
    type: "CollectionPage",
    breadcrumb: false,
  }),
  datasetSchema(locale, landing.meta.title, landing.meta.description, pathFor(locale)),
  faqSchema(
    pathFor(locale),
    landing.faq.items.map((item) => ({ question: item.q, answer: item.a })),
  ),
]);
---

<BaseLayout
  title={landing.meta.title}
  description={landing.meta.description}
  locale={locale}
  canonical={pathFor(locale)}
  alternates={hrefs}
  xDefault="/"
  schema={schema}
>
  <SiteShell locale={locale} alternatePath={pathFor(other)}>
    <PageHero
      locale={locale}
      eyebrow={landing.hero.eyebrow}
      icon="compass"
      title={landing.hero.title}
      lead={landing.hero.lead}
    >
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {ENGINES.map((engine) => <EngineLogo engine={engine} size={19} />)}
      </div>
      <StatGrid
        locale={locale}
        columns={4}
        items={[
          { label: t.stats.destinations, value: number(locale, NATIONAL.destinations) },
          { label: t.stats.hotels, value: number(locale, NATIONAL.hotelsTracked) },
          { label: t.stats.prompts, value: number(locale, listPrompts().length) },
          {
            label: t.stats.responses,
            value: number(locale, NATIONAL.responsesAnalyzed),
            hint: t.ui["measured-since"],
          },
        ]}
      />
      <div class="flex flex-wrap gap-2.5">
        <a class="btn gap-2" href={observatoryPath(locale)}>
          {landing.hero.cta}
          <Icon name="arrowRight" size={17} />
        </a>
        <a class="btn btn-secondary gap-2" href="#come">
          <Icon name="route" size={16} />
          {landing.hero["cta-secondary"]}
        </a>
      </div>
      <p class="text-[0.86rem] text-faint">{landing.hero.note}</p>
    </PageHero>

    <Section
      locale={locale}
      id="cosa"
      title={landing.what.title}
      lead={landing.what.lead}
      share={false}
    >
      <div class="grid items-start gap-[34px] lg:grid-cols-[7fr_5fr]">
        <div class="grid gap-3.5 sm:grid-cols-2">
          {
            FACTOR_KEYS.map((key) => (
              <Panel locale={locale} icon={factorIcon[key]} title={t.factors[key].name}>
                <p class="text-[0.92rem] text-muted">{t.explain[key]}</p>
                <p class="num text-[0.8rem] text-faint">
                  {t.factors.weight.replace("{n}", String(META.weights[key]))}
                </p>
              </Panel>
            ))
          }
        </div>
        <Panel locale={locale} title={t.national.title} lead={t.national.lead}>
          <div class="tricolore-edge grid gap-1">
            <span class="text-[0.85rem] text-muted">{t.score.national}</span>
            <span class="dial text-[2.6rem]">
              <span class="dial-value">{decimal(locale, NATIONAL.score, 0)}</span>
            </span>
          </div>
          <ScoreBreakdown locale={locale} factors={NATIONAL.factors} compact />
          <a
            class="inline-flex items-center gap-1.5 text-accent-ink"
            href={observatoryPath(locale)}
          >
            {t.national.leaderboard}
            <Icon name="arrowRight" size={15} />
          </a>
        </Panel>
      </div>
    </Section>

    <Section
      locale={locale}
      id="come"
      title={landing.how.title}
      lead={landing.how.lead}
      share={false}
    >
      <ol class="steps grid md:grid-cols-2 xl:grid-cols-4">
        {
          landing.how.steps.map((step, index) => (
            <li>
              <Panel locale={locale} class="h-full">
                <div class="flex items-center gap-2.5">
                  <span class="text-accent-ink">
                    <Icon name={stepIcons[index]} size={22} />
                  </span>
                  <span class="num text-[0.78rem] tracking-[0.12em] text-faint">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="h-px flex-1 bg-line" />
                </div>
                <h3 class="text-[1.02rem]">{step.name}</h3>
                <p class="text-[0.92rem] text-muted">{step.body}</p>
              </Panel>
            </li>
          ))
        }
      </ol>

      <div class="grid gap-3.5">
        <h3 class="text-[0.96rem] text-muted">{landing.how["rules-title"]}</h3>
        <div class="grid gap-3.5 md:grid-cols-2 xl:grid-cols-3">
          {
            readingRules.map((rule) => (
              <Panel
                locale={locale}
                tone="muted"
                icon={rule.icon}
                title={rule.title}
                headingLevel={4}
              >
                <p class="text-[0.92rem] text-muted">{rule.body}</p>
              </Panel>
            ))
          }
        </div>
      </div>
      <a class="inline-flex items-center gap-1.5 text-accent-ink" href={glossaryPath(locale)}>
        {t.ui.glossary}
        <Icon name="arrowRight" size={15} />
      </a>
    </Section>

    <Section
      locale={locale}
      id="categorie"
      title={t.national["categories-title"]}
      lead={t.national["categories-lead"]}
      share={false}
    >
      <div class="grid gap-3.5 md:grid-cols-2 xl:grid-cols-3">
        {
          categories.map((category) => (
            <a
              class="card lift grid content-start gap-3"
              href={categoryPath(locale, category.slug[locale])}
              data-cat={category.key}
            >
              <h3 class="flex items-center gap-2.5">
                <span class="cat-ink">
                  <Icon name={category.icon} size={21} />
                </span>
                {category.name[locale]}
              </h3>
              <p class="text-[0.9rem] text-muted">{category.lead[locale]}</p>
              <div class="flex flex-wrap items-center gap-2">
                <span class="pill num">{category.size} {t.stats.destinations}</span>
                <span class="dial ml-auto text-[1.1rem]">
                  <span class="dial-value">{decimal(locale, category.score, 0)}</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </Section>

    <Section
      locale={locale}
      id="inizia"
      title={landing.start.title}
      lead={landing.start.lead}
      share={false}
    >
      <div class="grid gap-3.5 md:grid-cols-2 xl:grid-cols-4">
        {
          landing.start.paths.map((path, index) => (
            <Panel locale={locale} icon={startLinks[index].icon} title={path.name} class="h-full">
              <p class="text-[0.92rem] text-muted">{path.body}</p>
              <a
                class="btn btn-secondary mt-auto justify-self-start gap-2"
                href={startLinks[index].href}
              >
                {path.cta}
                <Icon name="arrowRight" size={16} />
              </a>
            </Panel>
          ))
        }
      </div>
      <a class="inline-flex items-center gap-1.5 text-accent-ink" href={sitemapPath(locale)}>
        {t.sitemap.title}
        <Icon name="arrowRight" size={15} />
      </a>
    </Section>

    <Section
      locale={locale}
      id="faq"
      title={landing.faq.title}
      lead={landing.faq.lead}
      share={false}
    >
      <div class="grid gap-2.5 lg:grid-cols-2">
        {
          landing.faq.items.map((item) => (
            <details class="card grid content-start gap-2.5">
              <summary class="cursor-pointer">
                <h3 class="flex items-start gap-2.5 text-[1.02rem]">
                  <span class="mt-0.5 text-accent-ink">
                    <Icon name="info" size={17} />
                  </span>
                  <span>{item.q}</span>
                </h3>
              </summary>
              <p class="pl-[27px] text-[0.94rem] text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </Section>

    <Section
      locale={locale}
      id="dati"
      title={landing.open.title}
      lead={landing.open.lead}
      share={false}
    >
      <div class="grid gap-3.5 lg:grid-cols-[7fr_5fr]">
        <div class="table-wrap table-dense">
          <table>
            <thead>
              <tr>
                <th scope="col">{t.sitemap["branch-data"]}</th>
                <th scope="col">
                  <span class="th-label"><Icon name="territory" size={13} />{t.table.destination}</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {
                [
                  { path: "/api/destinations.json", note: t.sitemap["branch-destinations"] },
                  { path: "/api/categories.json", note: t.sitemap["branch-categories"] },
                  { path: "/api/queries.json", note: t.queries.title },
                  { path: "/api/hotels.json", note: t.hotels.title },
                  { path: "/llms.txt", note: t.methodology["data-title"] },
                ].map((row) => (
                  <tr>
                    <td class="num text-[0.88rem]">
                      <a class="hover:text-accent-ink" href={row.path}>
                        {row.path}
                      </a>
                    </td>
                    <td class="text-[0.88rem] text-muted">{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <Panel locale={locale} title={landing.closing.title} icon="info" tone="muted">
          <p class="text-[0.92rem] text-muted">{landing.closing.body}</p>
          <div class="flex flex-wrap gap-2.5">
            <a class="btn gap-2" href={observatoryPath(locale)}>
              {landing.closing.cta}
              <Icon name="arrowRight" size={16} />
            </a>
            <a class="btn btn-secondary" href={`mailto:${LINKS.email}`}>
              {m.common.corrections}
            </a>
          </div>
        </Panel>
      </div>
    </Section>
  </SiteShell>
</BaseLayout>
