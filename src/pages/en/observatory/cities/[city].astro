---
import CityPage from "../../../../templates/CityPage.astro";
import {
  findCity,
  localizedCityPaths,
} from "../../../../lib/observatory";

export function getStaticPaths() {
  return localizedCityPaths("en");
}

const city = findCity("en", Astro.params.city ?? "");
if (!city) return Astro.redirect("/en/observatory");
---

<CityPage locale="en" city={city} />
