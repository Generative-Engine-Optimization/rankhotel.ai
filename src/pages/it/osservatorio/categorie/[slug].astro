---
import CategoryPage from "../../../../templates/CategoryPage.astro";
import { findCategory, listCategories } from "../../../../lib/observatory";

export function getStaticPaths() {
  return listCategories().map((category) => ({ params: { slug: category.slug.it } }));
}

const category = findCategory("it", Astro.params.slug ?? "")!;
---

<CategoryPage locale="it" category={category} />
