---
import DestinationPage from "../../../../templates/DestinationPage.astro";
import { findDestination, listDestinations } from "../../../../lib/observatory";

export function getStaticPaths() {
  return listDestinations().map((destination) => ({
    params: { slug: destination.slug.it },
  }));
}

const destination = findDestination("it", Astro.params.slug ?? "")!;
---

<DestinationPage locale="it" destination={destination} />
