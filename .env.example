# =============================================================================
# Sorgente dei dati
# =============================================================================
#
# Copia questo file in `.env` e cambia solo ciò che ti serve. Senza `.env` il
# sito funziona: il default è la sorgente `fixtures`, cioè i JSON generati da
# `npm run data:generate` e serviti come file statici sotto /api/v1.
#
# Il passaggio al backend vero è tutto qui dentro. Nessun file di codice va
# toccato: né le pagine, né i componenti, né i template.

# fixtures | http
# fixtures  I JSON generati, serviti dal sito stesso. Default.
# http      Un backend vero. Richiede PUBLIC_API_BASE_URL.
PUBLIC_API_SOURCE=fixtures

# La base delle URL dell'API, senza barra finale. Finisce nel bundle del
# browser: qui va l'indirizzo pubblico, quello che vede l'utente.
# PUBLIC_API_BASE_URL=https://api.rankhotel.ai/v1

# Base usata solo a build time. Ha la precedenza su PUBLIC_API_BASE_URL quando
# il sito si compila: serve se il backend è raggiungibile su un indirizzo
# interno più veloce, o non ancora esposto in rete.
# API_BASE_URL=http://backend.internal:8080/v1

# Bearer token per le chiamate di build. NON finisce nel bundle del browser.
# API_TOKEN=

# Bearer token per le chiamate dal browser. Attenzione: è pubblico per
# definizione. Se l'API richiede un segreto vero, non va qui: va dietro un
# proxy che lo aggiunge lato server.
# PUBLIC_API_TOKEN=

# Timeout di una singola richiesta, in millisecondi. Default 15000.
# API_TIMEOUT_MS=15000

# Quante volte riprovare su errore di rete, timeout, 429 e 5xx. Un 404 non si
# ritenta mai. Default 2, con attesa crescente 300 ms / 900 ms.
# API_RETRIES=2
